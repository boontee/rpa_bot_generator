�BdefVar --name sourceFile --type String
defVar --name targetFile --type String
defVar --name reportFile --type String
defVar --name keyColumn --type Numeric
defVar --name compareColumn --type Numeric
defVar --name sourceApp --type String
defVar --name targetApp --type String
defVar --name reportApp --type String
defVar --name sourceLastRow --type Numeric
defVar --name targetLastRow --type Numeric
defVar --name reportRow --type Numeric
defVar --name sourceKey --type String
defVar --name sourceValue --type String
defVar --name targetKey --type String
defVar --name targetValue --type String
defVar --name lookupRow --type Numeric
defVar --name lookupColumn --type Numeric
defVar --name lookupFound --type Boolean
defVar --name sourceTable --type DataTable
defVar --name targetTable --type DataTable
defVar --name reportTable --type DataTable
defVar --name keyColumnName --type String
defVar --name matchedCount --type Numeric
defVar --name mismatchCount --type Numeric
defVar --name missingInTargetCount --type Numeric
defVar --name missingInSourceCount --type Numeric
defVar --name sourceColCount --type Numeric
defVar --name targetColCount --type Numeric
defVar --name rowCount --type Numeric
defVar --name columnCount --type Numeric

goSub --label Init
goSub --label LoadSourceFile
goSub --label LoadTargetFile
goSub --label Reconcile
goSub --label FlagMissingInSource
goSub --label WriteReportSummary
goSub --label Cleanup

beginSub --name Init
	onError --label ErrorHandler
	logMessage --message "→ Init: start" --type "Info"
	setVar --name "keyColumn" --value "1"
	setVar --name "compareColumn" --value "2"
	setVar --name "matchedCount" --value "0"
	setVar --name "mismatchCount" --value "0"
	setVar --name "missingInTargetCount" --value "0"
	setVar --name "missingInSourceCount" --value "0"
	setVar --name "reportRow" --value "2"
	addRow --datatable "${reportTable}" --valuesmapping "Key=Key,SourceValue=Source Value,TargetValue=Target Value,Status=Status"
	logMessage --message "← Init: done" --type "Info"
endSub

beginSub --name LoadSourceFile
	onError --label ErrorHandler
	logMessage --message "→ LoadSourceFile: start" --type "Info"
	excelOpen --path "${sourceFile}" --readOnly true   sourceApp=value
	excelGetTable --application "${sourceApp}" --sheet "Sheet1" --fromRow 1 --fromColumn 1   sourceTable=value
	getTableInformation --datatable "${sourceTable}"   rowCount=value columnCount=value
	setVar --name "sourceLastRow" --value "${rowCount}"
	mapTableRow --datatable "${sourceTable}" --rownumber "0" --columns "1"   keyColumnName=value
	if --left "${sourceLastRow}" --operator "Less_Than" --right "2"
		logMessage --message "LoadSourceFile: source file has no data rows" --type "Error"
		goSub --label Cleanup
		failTest --message "Source file is empty: ${sourceFile}"
	endIf
	logMessage --message "← LoadSourceFile: done" --type "Info"
endSub

beginSub --name LoadTargetFile
	onError --label ErrorHandler
	logMessage --message "→ LoadTargetFile: start" --type "Info"
	excelOpen --path "${targetFile}" --readOnly true   targetApp=value
	excelGetTable --application "${targetApp}" --sheet "Sheet1" --fromRow 1 --fromColumn 1   targetTable=value
	getTableInformation --datatable "${targetTable}"   rowCount=value columnCount=value
	setVar --name "targetLastRow" --value "${rowCount}"
	if --left "${targetLastRow}" --operator "Less_Than" --right "2"
		logMessage --message "LoadTargetFile: target file has no data rows" --type "Warning"
	endIf
	logMessage --message "← LoadTargetFile: done" --type "Info"
endSub

beginSub --name Reconcile
	onError --label ErrorHandler
	logMessage --message "→ Reconcile: start" --type "Info"
	getTableInformation --datatable "${sourceTable}"   rowCount=value columnCount=value
	setVar --name "sourceLastRow" --value "${rowCount}"
	for --variable ${reportRow} --from 2 --to ${sourceLastRow} --step 1
		mapTableRow --datatable "${sourceTable}" --rownumber "${reportRow}" --columns "1,2"   sourceKey=value sourceValue=value
		findTableCellOccurrence --datatable "${targetTable}" --value "${sourceKey}" --columnname "${keyColumnName}"   lookupRow=value lookupColumn=value lookupFound=value
		if --left "${lookupFound}" --operator "Is_True"
			mapTableRow --datatable "${targetTable}" --rownumber "${lookupRow}" --columns "2"   targetValue=value
			if --left "${sourceValue}" --operator "Equal_To" --right "${targetValue}"
				addRow --datatable "${reportTable}" --valuesmapping "Key=${sourceKey},SourceValue=${sourceValue},TargetValue=${targetValue},Status=MATCHED"
				evaluate --expression "${matchedCount} + 1"   matchedCount=value
			else
				addRow --datatable "${reportTable}" --valuesmapping "Key=${sourceKey},SourceValue=${sourceValue},TargetValue=${targetValue},Status=MISMATCH"
				evaluate --expression "${mismatchCount} + 1"   mismatchCount=value
				logMessage --message "MISMATCH key=${sourceKey} source=${sourceValue} target=${targetValue}" --type "Warning"
			endIf
		else
			addRow --datatable "${reportTable}" --valuesmapping "Key=${sourceKey},SourceValue=${sourceValue},TargetValue= ,Status=MISSING IN TARGET"
			evaluate --expression "${missingInTargetCount} + 1"   missingInTargetCount=value
			logMessage --message "MISSING IN TARGET key=${sourceKey}" --type "Warning"
		endIf
	next
	logMessage --message "← Reconcile: done" --type "Info"
endSub

beginSub --name FlagMissingInSource
	onError --label ErrorHandler
	logMessage --message "→ FlagMissingInSource: start" --type "Info"
	getTableInformation --datatable "${targetTable}"   rowCount=value columnCount=value
	setVar --name "targetLastRow" --value "${rowCount}"
	for --variable ${lookupRow} --from 2 --to ${targetLastRow} --step 1
		mapTableRow --datatable "${targetTable}" --rownumber "${lookupRow}" --columns "1,2"   targetKey=value targetValue=value
		findTableCellOccurrence --datatable "${sourceTable}" --value "${targetKey}" --columnname "${keyColumnName}"   lookupFound=value
		if --left "${lookupFound}" --operator "Is_False"
			addRow --datatable "${reportTable}" --valuesmapping "Key=${targetKey},SourceValue= ,TargetValue=${targetValue},Status=MISSING IN SOURCE"
			evaluate --expression "${missingInSourceCount} + 1"   missingInSourceCount=value
			logMessage --message "MISSING IN SOURCE key=${targetKey}" --type "Warning"
		endIf
	next
	logMessage --message "← FlagMissingInSource: done" --type "Info"
endSub

beginSub --name WriteReportSummary
	onError --label ErrorHandler
	logMessage --message "→ WriteReportSummary: start" --type "Info"
	addRow --datatable "${reportTable}" --valuesmapping "Key= ,SourceValue= ,TargetValue= ,Status= "
	addRow --datatable "${reportTable}" --valuesmapping "Key=SUMMARY,SourceValue= ,TargetValue= ,Status= "
	addRow --datatable "${reportTable}" --valuesmapping "Key=Matched,SourceValue=${matchedCount},TargetValue= ,Status= "
	addRow --datatable "${reportTable}" --valuesmapping "Key=Mismatch,SourceValue=${mismatchCount},TargetValue= ,Status= "
	addRow --datatable "${reportTable}" --valuesmapping "Key=Missing In Target,SourceValue=${missingInTargetCount},TargetValue= ,Status= "
	addRow --datatable "${reportTable}" --valuesmapping "Key=Missing In Source,SourceValue=${missingInSourceCount},TargetValue= ,Status= "
	excelOpen --path "${reportFile}" --readOnly false   reportApp=value
	excelCreateFromDataTable --application "${reportApp}" --sheet "Sheet1" --datatable "${reportTable}" --startRow 1 --startColumn 1
	excelSave --application "${reportApp}"
	logMessage --message "RECONCILIATION COMPLETE matched=${matchedCount} mismatch=${mismatchCount} missingInTarget=${missingInTargetCount} missingInSource=${missingInSourceCount}" --type "Info"
	logMessage --message "← WriteReportSummary: done" --type "Info"
endSub

beginSub --name ErrorHandler
	logMessage --message "ErrorHandler: an unexpected error occurred during reconciliation" --type "Error"
	goSub --label Cleanup
	failTest --message "An unexpected error occurred during reconciliation"
endSub

beginSub --name Cleanup
	logMessage --message "→ Cleanup: start" --type "Info"
	if --left "${sourceApp}" --operator "Is_Not_Empty"
		excelClose --file "${sourceApp}"
	endIf
	if --left "${targetApp}" --operator "Is_Not_Empty"
		excelClose --file "${targetApp}"
	endIf
	if --left "${reportApp}" --operator "Is_Not_Empty"
		excelClose --file "${reportApp}"
	endIf
	logMessage --message "← Cleanup: done" --type "Info"
endSub
*30.0.3.0